---
/**
 * 页脚组件
 * 展示版权信息与社交链接，作为全站统一页脚复用。
 */
import { SOCIAL_LINKS, SITE_AUTHOR } from '../constants/site';
---

<!-- border-t border-border: 顶部分隔线 -->
<footer class="border-t border-border bg-bg-primary py-8">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
      <!-- 版权信息：动态获取当前年份 -->
      <p class="text-sm text-text-muted">
        &copy; {new Date().getFullYear()} {SITE_AUTHOR}. 保留所有权利。
      </p>

      <!-- 社交链接列表 -->
      <ul class="flex items-center gap-6">
        {
          SOCIAL_LINKS.map((social) => (
            <li>
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium text-text-secondary transition-colors hover:text-accent"
                aria-label={social.ariaLabel}
              >
                {social.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
