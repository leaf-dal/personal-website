---
/**
 * 首页首屏组件（Sternstunden 主题）
 * 超大字母水印背景 + 左右分栏布局：
 * 左侧 45% 为抽象紫粉渐变视觉与环绕技术栈标签，
 * 右侧 55% 展示姓名、简介与发光的 Sternstunden 主题词。
 */
import {
  HERO_TITLE,
  HERO_SUBTITLE,
  HERO_DESCRIPTION
} from '../constants/site';

// Sternstunden 超大背景字母，横向铺满屏幕
const bgLetters = ['S', 'T', 'E', 'R', 'N', 'S', 'T', 'U', 'N', 'D', 'E', 'N'];

// 左侧背景装饰性大写英文单词：作为底纹，填补空白并强化主题
const decorWords = ['DEVELOPER', 'CREATIVE', 'CODE'];

// 首页左侧环绕的技术栈标签：选取核心技能，均匀分布在球体周围
const skillTags = [
  { name: 'Python', icon: '🐍' },
  { name: 'AI 工具', icon: '✨' },
  { name: 'Astro', icon: '🚀' },
  { name: 'React', icon: '⚛️' },
  { name: 'Tailwind', icon: '🎨' },
  { name: 'PPT 设计', icon: '📊' }
];
---

<!--
  首屏容器：
  min-h-screen 占满整个视口高度，
  overflow-hidden 防止超大字母溢出产生滚动条，
  flex items-center 让内容垂直居中。
-->
<section class="relative flex min-h-screen items-center overflow-hidden px-4 sm:px-6 lg:px-8">
  <!-- ===== 超大字母水印背景 ===== -->
  <div
    class="pointer-events-none absolute inset-0 z-0 flex items-center justify-between px-2 select-none"
    aria-hidden="true"
  >
    {
      bgLetters.map((letter) => (
        <span class="stern-letter flex-1 text-center font-black uppercase leading-none text-transparent">
          {letter}
        </span>
      ))
    }
  </div>

  <!-- ===== 主内容区：左右分栏 ===== -->
  <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-12 lg:grid-cols-[45fr_55fr]">
    <!-- 左侧：抽象视觉 + 环绕技术栈标签 -->
    <div class="relative order-2 flex min-h-[480px] items-center justify-center lg:order-1">
      <!-- 左侧背景装饰词：超大、极低透明度，作为底纹填补空白 -->
      <div class="pointer-events-none absolute inset-0 z-0 select-none" aria-hidden="true">
        {
          decorWords.map((word, index) => {
            const positions = [
              'top-[5%] left-[2%]',
              'top-[42%] right-[-4%]',
              'bottom-[8%] left-[8%]'
            ];
            return (
              <span class={`decor-word absolute ${positions[index]}`} style={`animation-delay: ${index * 0.6}s;`}>
                {word}
              </span>
            );
          })
        }
      </div>

      <!-- 抽象头像/视觉：紫粉渐变圆形 + 几何线条（整体放大 20%-30%） -->
      <div class="abstract-portrait relative flex h-80 w-80 items-center justify-center sm:h-96 sm:w-96 lg:h-[28rem] lg:w-[28rem]">
        <!-- 外层柔和光晕 -->
        <div class="absolute inset-0 rounded-full bg-gradient-to-br from-accent/20 via-secondary/20 to-transparent blur-2xl"></div>
        <!-- 主渐变圆形 -->
        <div class="relative z-10 flex h-64 w-64 items-center justify-center rounded-full bg-gradient-to-br from-accent via-secondary to-accent/60 shadow-2xl shadow-accent/20 sm:h-80 sm:w-80 lg:h-[22rem] lg:w-[22rem]">
          <!-- 内部装饰线条：模拟声纹 / 代码轨迹 -->
          <svg
            class="h-36 w-36 text-white/40 sm:h-44 sm:w-44 lg:h-52 lg:w-52"
            viewBox="0 0 100 100"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          >
            <path d="M10 50 Q 25 20, 40 50 T 70 50 T 100 50" />
            <path d="M10 60 Q 25 30, 40 60 T 70 60 T 100 60" opacity="0.6" />
            <path d="M10 40 Q 25 10, 40 40 T 70 40 T 100 40" opacity="0.6" />
            <circle cx="50" cy="50" r="4" fill="currentColor" />
          </svg>
        </div>
      </div>

      <!-- 环绕技术栈标签：带轻微上下浮动动画，悬停放大 -->
      {
        skillTags.map((tag, index) => {
          const rotations = ['-5deg', '4deg', '-3deg', '5deg', '-4deg', '3deg'];
          return (
            <div
              class={`skill-tag skill-tag-${index + 1}`}
              style={`--rotate: ${rotations[index]}; animation-delay: ${index * 0.4}s;`}
            >
              <span class="text-lg sm:text-xl">{tag.icon}</span>
              <span class="ml-1 text-xs font-medium whitespace-nowrap text-text-primary sm:text-sm">{tag.name}</span>
            </div>
          );
        })
      }
    </div>

    <!-- 右侧：文字内容 -->
    <div class="order-1 text-center lg:order-2 lg:text-left">
      <!-- 身份标签 -->
      <p class="mb-4 text-sm font-light uppercase tracking-[0.3em] text-text-muted sm:text-base">
        {HERO_SUBTITLE}
      </p>

      <!-- 主标题：姓名 -->
      <h1 class="text-5xl font-bold tracking-tight text-text-primary sm:text-6xl lg:text-7xl">
        王佳叶
      </h1>

      <!-- Sternstunden：发光效果主题词 -->
      <p class="stern-glow mt-3 font-serif text-3xl italic tracking-wide sm:text-4xl lg:text-5xl">
        Sternstunden
      </p>

      <!-- 副标题：点明主题 -->
      <p class="mt-4 text-base italic text-text-secondary sm:text-lg">
        在代码和创意之间，寻找我的 Sternstunden。
      </p>

      <!-- 个人简介 -->
      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-text-secondary lg:mx-0 lg:max-w-lg">
        {HERO_DESCRIPTION}
      </p>

      <!-- 行动按钮 -->
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
        <a
          href="/projects"
          class="btn-primary inline-flex items-center justify-center rounded-lg px-8 py-3 text-base font-semibold"
        >
          查看项目
        </a>
        <a
          href="/about"
          class="inline-flex items-center justify-center rounded-lg border border-border px-8 py-3 text-base font-semibold text-text-primary transition-all duration-300 hover:-translate-y-0.5 hover:border-accent hover:text-accent hover:shadow-lg hover:shadow-accent/5"
        >
          了解更多
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ===== 超大字母水印 ===== */
  .stern-letter {
    font-size: clamp(3rem, 14vw, 12rem);
    background: linear-gradient(135deg, #7c3aed 0%, #ec4899 100%);
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0.04;
  }

  /* ===== Sternstunden 发光文字 ===== */
  .stern-glow {
    background: linear-gradient(135deg, #7c3aed 0%, #ec4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow:
      0 0 20px rgba(124, 58, 237, 0.25),
      0 0 40px rgba(236, 72, 153, 0.15);
  }

  /* ===== 抽象视觉微浮动动画 ===== */
  .abstract-portrait {
    animation: portrait-float 6s ease-in-out infinite;
  }

  @keyframes portrait-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  /* ===== 环绕技术栈标签 ===== */
  .skill-tag {
    position: absolute;
    display: flex;
    align-items: center;
    padding: 0.5rem 0.9rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(124, 58, 237, 0.12);
    box-shadow: 0 8px 24px -12px rgba(124, 58, 237, 0.2);
    /* 默认缩放比例为 1，悬停时通过 CSS 变量放大，避免覆盖浮动动画 */
    --tag-scale: 1;
    transition: box-shadow 0.25s ease;
    animation: tag-float 3s ease-in-out infinite;
  }

  .skill-tag:hover {
    --tag-scale: 1.15;
    box-shadow: 0 12px 32px -10px rgba(124, 58, 237, 0.35);
    z-index: 20;
  }

  /* 6 个标签围绕球体分布，移动端适当内收；
     使用 CSS 变量 --rotate 保持倾斜角度，动画中同步保留 */
  .skill-tag-1 { top: 8%; left: 5%; }
  .skill-tag-2 { top: 35%; left: -2%; }
  .skill-tag-3 { bottom: 12%; left: 8%; }
  .skill-tag-4 { top: 12%; right: 5%; }
  .skill-tag-5 { top: 40%; right: -2%; }
  .skill-tag-6 { bottom: 10%; right: 8%; }

  @media (min-width: 640px) {
    .skill-tag-1 { top: 6%; left: 10%; }
    .skill-tag-2 { top: 34%; left: 4%; }
    .skill-tag-3 { bottom: 10%; left: 12%; }
    .skill-tag-4 { top: 10%; right: 10%; }
    .skill-tag-5 { top: 38%; right: 4%; }
    .skill-tag-6 { bottom: 8%; right: 12%; }
  }

  /* 标签轻微上下浮动动画：保留倾斜角度，同时响应悬停缩放变量 */
  @keyframes tag-float {
    0%,
    100% {
      transform: rotate(var(--rotate, 0deg)) translateY(0) scale(var(--tag-scale, 1));
    }
    50% {
      transform: rotate(var(--rotate, 0deg)) translateY(-10px) scale(var(--tag-scale, 1));
    }
  }

  /* ===== 左侧背景装饰词：超大、极低透明度，营造底纹质感 ===== */
  .decor-word {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    color: rgba(124, 58, 237, 0.05);
    animation: decor-pulse 5s ease-in-out infinite;
  }

  @keyframes decor-pulse {
    0%,
    100% {
      opacity: 0.04;
      transform: translateY(0);
    }
    50% {
      opacity: 0.07;
      transform: translateY(-6px);
    }
  }
</style>
