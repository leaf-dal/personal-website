---
/**
 * 首页首屏组件
 * 展示个人名称、拼音、一句话简介、详细描述以及两个主要行动按钮。
 */
import {
  HERO_TITLE,
  HERO_SUBTITLE,
  HERO_DESCRIPTION,
  SITE_AUTHOR_PINYIN
} from '../constants/site';
import GhostElement from './GhostElement.astro';
---

<!--
  min-h-[calc(100vh-4rem)]: 首屏高度 = 视口高度减去固定导航栏高度（4rem = h-16）
  flex items-center: 内容垂直居中
  text-center: 文字水平居中
  relative: 为 Ghost 装饰元素提供定位上下文
-->
<section class="relative flex min-h-[calc(100vh-4rem)] items-center justify-center px-4 sm:px-6 lg:px-8">
  <!-- 右上角幽灵装饰，为黑白页面增加趣味 -->
  <GhostElement opacity={0.15} positionClass="top-20 right-6 sm:top-16 sm:right-12" />

  <div class="relative z-10 mx-auto max-w-3xl text-center">
    <!-- 小标题/标签：身份定位 -->
    <p class="mb-4 text-sm font-medium uppercase tracking-widest text-accent sm:text-base">
      {HERO_SUBTITLE}
    </p>

    <!-- 主标题：打字机效果容器，文字使用紫粉渐变 -->
    <h1
      id="typewriter-title"
      class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl"
      data-text={HERO_TITLE}
    >
      <span class="typewriter-text gradient-text"></span>
      <span class="typewriter-cursor" aria-hidden="true">|</span>
    </h1>

    <!-- 副标题：斜体小字，点明 Sternstunden 主题 -->
    <p class="mt-4 text-base italic text-text-secondary sm:text-lg">
      在代码和创意之间，寻找我的 Sternstunden。
    </p>

    <!-- 拼音标注：全大写 + 加宽字间距，增强设计感 -->
    <p class="mt-3 text-sm font-medium uppercase tracking-[0.5em] text-text-muted sm:text-base">
      {SITE_AUTHOR_PINYIN}
    </p>

    <!-- 描述文字 -->
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-text-secondary sm:text-xl">
      {HERO_DESCRIPTION}
    </p>

    <!-- 行动按钮组 -->
    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <!-- 主按钮：查看项目，使用紫粉渐变 -->
      <a
        href="/projects"
        class="btn-primary inline-flex items-center justify-center rounded-lg px-8 py-3 text-base font-semibold"
      >
        查看项目
      </a>

      <!-- 次按钮：了解更多 -->
      <a
        href="/about"
        class="inline-flex items-center justify-center rounded-lg border border-border px-8 py-3 text-base font-semibold text-text-primary transition-all duration-300 hover:-translate-y-0.5 hover:border-accent hover:text-accent hover:shadow-lg hover:shadow-accent/5"
      >
        了解更多
      </a>
    </div>
  </div>
</section>

<style>
  /* 打字机光标闪烁动画 */
  .typewriter-cursor {
    display: inline-block;
    width: 0.08em;
    color: var(--color-accent);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  /**
   * 首页标题打字机效果
   * 页面加载后逐字显示标题，营造科技感。
   */
  const titleEl = document.getElementById('typewriter-title');
  const textEl = titleEl?.querySelector('.typewriter-text');
  const fullText = titleEl?.getAttribute('data-text') || '';

  /** 当前已显示的字符索引 */
  let charIndex = 0;

  /**
   * 逐字追加到显示区域
   * 每个字符间隔 120ms，兼顾节奏感与可读性。
   */
  function typeNextChar(): void {
    if (!textEl || charIndex >= fullText.length) return;

    textEl.textContent += fullText.charAt(charIndex);
    charIndex += 1;

    if (charIndex < fullText.length) {
      setTimeout(typeNextChar, 120);
    }
  }

  // 延迟 300ms 开始打字，让页面其他元素先完成渲染
  setTimeout(typeNextChar, 300);
</script>
