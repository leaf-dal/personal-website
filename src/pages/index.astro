---
/**
 * 首页（单页滚动布局）
 * 全站内容整合为三段式单页滚动：
 *   #home 首页（星空首屏 + 引言 + 技能/成就/资源/Global Glow/时间线）
 *   → #about 关于我（个人简介、技能栈、联系我）
 *   → #projects 项目展示（项目卡片网格 + 详情模态框）
 * 顶部导航栏通过锚点 + 全局 scroll-behavior: smooth 实现平滑滚动定位。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionTitle from '../components/SectionTitle.astro';
import GhostElement from '../components/GhostElement.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_DESCRIPTION, SOCIAL_LINKS } from '../constants/site';
// 书架组件样式（作用域限定在 .bookshelf-wrap 内，避免与全站样式冲突）
import '../styles/bookshelf.css';

// ====================================================================
// 首页板块数据（原首页内容）
// ====================================================================

// 我的技能数据：成熟简练的表达，突出可提供的实际帮助
const skillItems = [
  {
    title: 'PPT 视觉设计',
    description:
