    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
  }

  /* 移动端适配：竖向堆叠，取消扇形偏移 */
  @media (max-width: 768px) {
    .photo-stack {
      height: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }
    .photo-card {
      position: relative;
      top: auto;
      left: auto;
      transform: none !important;
      width: 260px;
      height: 380px;
