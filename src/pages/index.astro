<script>
  // ==================================================================
  // 「看看我的那些瞬间」按钮：平滑滚动到个人时间线
  // 使用 requestAnimationFrame 逐帧滚动，时长约 0.8 秒（easeInOutCubic 缓动）
  // ==================================================================
  const timelineBtn = document.getElementById('scroll-timeline-btn');
  const timelineSection = document.getElementById('timeline');

  /**
   * 自定义平滑滚动：从当前位置缓动到目标纵坐标
   * @param targetY 目标纵坐标（绝对位置，px）
   * @param duration 动画时长（毫秒）
   */
  function smoothScrollToY(targetY: number, duration: number = 800): void {
    // 动画期间临时关闭全局 CSS 平滑滚动，避免与逐帧滚动互相冲突
    const root = document.documentElement;
    const prevBehavior = root.style.scrollBehavior;
    root.style.scrollBehavior = 'auto';

    const startY = window.scrollY;
    const distance = targetY - startY;
    const startTime = performance.now();

    function step(now: number): void {
      const progress = Math.min((now - startTime) / duration, 1);
      // easeInOutCubic 缓动：先慢后快再慢，滚动观感更自然
      const eased =
        progress < 0.5
          ? 4 * progress * progress * progress
          : 1 - Math.pow(-2 * progress + 2, 3) / 2;
      window.scrollTo(0, startY + distance * eased);
      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        root.style.scrollBehavior = prevBehavior; // 恢复原有滚动行为
      }
    }
    requestAnimationFrame(step);
  }

  timelineBtn?.addEventListener('click', () => {
    if (!timelineSection) return;
    // 目标位置向上偏移 80px，为固定导航栏留出空间，避免标题被遮挡
    const targetY =
      timelineSection.getBoundingClientRect().top + window.scrollY - 80;
    smoothScrollToY(Math.max(targetY, 0), 800);
  });
</script>

<style>
  /* ------------------------------------------------------------------
     引言延迟浮现动画
     - 页面加载后等待 1.5s，再用 2s 从透明 + 下方 10px 淡入升起
     - 纯 opacity + transform 动画，不使用 max-height，避免内容被裁切
     ------------------------------------------------------------------ */
  #quote-full {
    opacity: 0;
    transform: translateY(10px);
    animation: quote-fade-in 2s ease-out 1.5s forwards;
  }

  @keyframes quote-fade-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* My Skills 标题：纯白 #FFFFFF、字重 600、字号更大，避免发虚 */
  [aria-labelledby='skills-heading'] h2 {
    color: #ffffff !important;
    font-weight: 600;
    font-size: 3.25rem !important;
  }
  [aria-labelledby='skills-heading'] h2 + p {
    color: rgba(255, 255, 255, 0.7) !important;
  }

  /* 展开状态：按钮箭头旋转 180°（向上） */
  #quote-toggle.is-expanded .quote-arrow {
    transform: rotate(180deg);
  }

  /* ------------------------------------------------------------------
     时间线按钮：脉冲动画 + 悬停变亮
     - cta-pulse：光晕圆环由内向外扩散并淡出，每 2 秒循环，吸引点击
     - hover：提高亮度，营造「被点亮」的感觉
     ------------------------------------------------------------------ */
  @keyframes cta-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(124, 58, 237, 0.4);
    }
    70% {
      box-shadow: 0 0 0 18px rgba(124, 58, 237, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(124, 58, 237, 0);
    }
  }

  .cta-pulse-btn {
    animation: cta-pulse 2s ease-out infinite;
  }

  .cta-pulse-btn:hover {
    filter: brightness(1.18);
  }

  /* ------------------------------------------------------------------
     时间线圆点：紫粉渐变的小圆，中心对齐到左侧时间轴竖线
     - 左偏移 -38px：让圆点中心恰好落在 ol 的 border-left 上
     ------------------------------------------------------------------ */
  .timeline-dot {
    position: absolute;
    left: -38px;
    top: 28px;
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.12);
  }

  /* ================================================================
     动漫照片 · 3D 扇形堆叠翻转卡片
     - 5 张卡片呈扇形散开，正中为 C 位
     - 点击翻转（rotateY 180°），翻转时 z-index 提升到最上层
     ================================================================= */
  .photo-stack {
    perspective: 1000px;
    position: relative;
    height: 450px;
    margin: 0 auto;
    max-width: 600px;
  }

  .photo-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 220px;
    height: 320px;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  /* 扇形散开：第 1 张左偏 */
  .photo-card:nth-child(1) {
    transform: translate(-50%, -50%) rotate(-12deg) translate(-100px, 15px);
    z-index: 1;
  }
  /* 第 2 张左偏小 */
  .photo-card:nth-child(2) {
    transform: translate(-50%, -50%) rotate(-4deg) translate(-30px, 8px);
    z-index: 2;
  }
  /* 第 3 张正中 C 位 */
  .photo-card:nth-child(3) {
    transform: translate(-50%, -50%) rotate(0deg);
    z-index: 3;
  }
  /* 第 4 张右偏小 */
  .photo-card:nth-child(4) {
    transform: translate(-50%, -50%) rotate(4deg) translate(30px, 8px);
    z-index: 2;
  }
  /* 第 5 张右偏 */
  .photo-card:nth-child(5) {
    transform: translate(-50%, -50%) rotate(12deg) translate(100px, 15px);
    z-index: 1;
  }

  /* 翻转时提升到最上层，避免被其他卡片遮挡 */
  .photo-card.flipped {
    z-index: 10 !important;
  }

  /* 3D 翻转核心 */
  .card-inner {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 1.1s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .photo-card.flipped .card-inner {
    transform: rotateY(180deg);
  }

  .card-front,
  .card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .card-back {
    transform: rotateY(180deg);
    background: rgba(30, 30, 50, 0.95);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
    text-align: center;
  }

