  }
];

// 个人时间线数据：我的成长轨迹（AI + 养老交叉领域）
const timelineItems = [
  {
    date: '2025.09',
    title: '入学老年服务与管理专业',
    description:
      '迈入大学校园，开启老年服务与管理方向的学习，也在心里种下「用科技服务长辈」的种子。'
  },
  {
    date: '2025.11',
    title: '聚焦 AI + 养老交叉领域',
    description:
      '开始系统关注人工智能与养老产业的结合点，探索如何让技术为照护增添温度。'
  },
  {
    date: '2026.03',
    title: '完成第一份行业研究报告',
    description:
      '独立完成 AI + 养老方向的首份行业研究报告，梳理了产业图谱与发展趋势。'
  },
  {
    date: '2026.06',
    title: '搭建个人网站，记录思考',
    description:
      '从 PPT 到代码，用这个网站记录成长轨迹，也把它作为连接志同道合者的窗口。'
  }
];

// Global Glow 调研实践数据：适老化智能产品专项调研（线上 + 线下结合）
const glowSurveyItems = [
  {
    icon: '🔍',
    title: '线上调研',
    description:
      '在淘宝、京东搜索「老人智能手环」「AI陪伴机器人」等产品，重点翻阅差评区，发现续航短、操作复杂、数据不准是高频槽点；在抖音、B站观看「教老人用手机」「适老化改造」相关视频，直观看到老人面对嵌套菜单、语音指令时的操作卡点。'
  },
  {
    icon: '👀',
    title: '线下观察',
    description:
      '观察家中长辈和社区老人使用智能设备的情况，发现很多人因不会操作、怕按错扣费、觉得被「监控」等原因，将设备闲置。'
  },
  {
    icon: '💡',
    title: '核心发现',
    description:
      '适老化产品普遍存在操作门槛高、功能与需求错位、老人心理抵触、信任感不足等问题，很多设备买回去成了摆设。'
  }
];

// Global Glow 实践成果：沉淀为文章发布在行业观察板块
const glowAchievements = [
  '测评 3 款 AI 陪伴机器人',
  '为什么智能手环戴三天就闲置？'
];

// ====================================================================
// 关于我板块数据（原 about 页面）
// ====================================================================

// 技能标签列表
const skillTags = [
  'HTML5',
  'CSS3',
  'JavaScript',
  'TypeScript',
  'React',
  'Vue',
  'Astro',
  'Tailwind CSS',
  'Node.js',
  'Git',
  'Python',
  'AI 工具',
  '视频剪辑',
  'PPT 设计'
];

// ====================================================================
// 项目展示板块数据（原 projects 页面）
// ====================================================================

// 项目列表数据：4 个精选项目，均为占位链接（href="#"）
const projectList = [
  {
    id: 'tank',
    title: 'Vibe Coding 坦克游戏',
    description: '使用 Vibe Coding 制作的坦克游戏。',
    tags: [],
    link: '#',
    demoUrl: '#'
  },
  {
    id: 'website',
    title: '个人网站搭建',
    description: '即当前网站，记录成长轨迹与分享资源。',
    tags: [],
    link: '#',
    demoUrl: '#'
  },
  {
    id: 'ai-music',
    title: 'AI 音乐学习助手',
    description: '用 AI 辅助制作的音乐学习助手。',
    tags: [],
    link: '#',
    demoUrl: '#'
  },
  {
    id: 'odyssey',
    title: '《奥德赛》科普视频',
    description: 'AI 制作的主题科普视频。',
    tags: [],
    link: '#',
    demoUrl: '#'
  }
];
---

<BaseLayout title="首页" description={SITE_DESCRIPTION}>
  <!-- ==============================================================
       板块一：首页 / 星空首屏（#home）
       包含首屏 Hero、引言、时间线按钮、技能、成就、资源、Global Glow、个人时间线
       ============================================================== -->
  <section id="home" class="relative min-h-screen">
    <!-- 首屏（星空氛围 + 向下滚动箭头提示） -->
    <HeroSection />

    <!-- 引言区：茨威格《人类的群星闪耀时》名言 · 延迟 1.5s 淡入浮现 -->
    <section class="relative z-10 py-52 sm:py-64" aria-labelledby="quote-heading">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <!-- 装饰性小标题：呼应网站 Sternstunden（群星闪耀）主题，颜色白色与中文内容一致 -->
        <p id="quote-heading" class="text-sm font-light uppercase tracking-[0.3em] text-white">
          Sternstunden der Menschheit
        </p>

        <blockquote class="mt-6">
          <!-- 简短版引言：#E8E8E8 非纯白、无衬线字体、淡阴影浮出星空 -->
          <p
            class="text-2xl leading-relaxed sm:text-3xl"
            style="color: #E8E8E8; font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);"
          >
            「命运攸关的一分钟」
          </p>

          <!--
            完整引言：默认展开，延迟 1.5s 后用 2s 从下方 10px 淡入浮现
            文字颜色 #E8E8E8、无衬线字体、淡阴影
          -->
          <div id="quote-full" class="quote-full">
            <p
              class="mt-5 text-base leading-loose sm:text-lg"
              style="color: #E8E8E8; font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);"
            >
              这种充满戏剧性和命运攸关的时刻在个人的一生中和历史的进程中都十分难得；这种时刻往往只发生在某一天、某一小时甚至常常只发生在某一分钟，但它们的决定性影响却超越时间。
            </p>
            <footer
              class="mt-4 text-sm"
              style="color: rgba(232, 232, 232, 0.7); font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);"
            >
              —— 斯蒂芬·茨威格《人类的群星闪耀时》
            </footer>
          </div>
        </blockquote>
      </div>
    </section>

    <!-- 首页中央：滚动到时间线的脉冲按钮 -->
    <div class="relative z-10 flex justify-center py-12">
      <button
        id="scroll-timeline-btn"
        type="button"
        class="cta-pulse-btn inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-accent to-[#EC4899] px-8 py-3 text-base font-semibold text-white shadow-lg shadow-accent/30 transition-all duration-300 hover:-translate-y-0.5"
      >
        <span>看看我的那些瞬间</span>
        <!-- 向下箭头图标：提示下方还有内容 -->
        <svg
          class="h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>

    <!-- 过渡文案：名言与技能区之间，半透明白色不抢戏 -->
    <p
      class="relative z-10 text-center text-sm"
      style="color: rgba(255, 255, 255, 0.5); letter-spacing: 2px; margin: 40px 0 20px 0;"
    >
      群星之下，是我此刻的坐标。
    </p>

    <!-- 我的技能区 -->
    <section class="relative z-10 py-52 sm:py-64" aria-labelledby="skills-heading">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <SectionTitle
          title="My Skills"
          subtitle="PPT · Python · AI 创作 · 视频剪辑"
        />

        <!--
          grid: 移动端单列，md 双列，lg 三列
          gap-8: 卡片间距
        -->
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {
            skillItems.map((skill) => (
              <div class="rounded-xl border border-border bg-bg-secondary p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-xl hover:shadow-accent/5">
                <h3 id="skills-heading" class="text-lg font-bold text-text-primary">
                  {skill.title}
                </h3>
                <p class="mt-3 text-base leading-relaxed text-text-secondary">
                  {skill.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 我的成就区：展示科大讯飞 AI 大学堂认证证书 -->
    <section class="relative z-10 py-52 sm:py-64" aria-labelledby="achievements-heading">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <SectionTitle
          title="My Achievements"
          subtitle="我的成就"
        />

        <!--
          成就证书网格：
          移动端 1 列，平板 2 列，桌面 4 列。
          gap-8 拉大证书间距，px-2 保证左右留白，避免证书紧贴在一起。
        -->
        <div
          id="achievements-grid"
          class="grid gap-8 px-2 sm:grid-cols-2 lg:grid-cols-4"
        >
          <article class="overflow-hidden rounded-2xl border border-border bg-bg-secondary transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-accent/5">
            <div class="aspect-[4/3] overflow-hidden bg-white">
              <img
                src={`${import.meta.env.BASE_URL}zhengshu/weitiao-engineer.png`}
                alt="科大讯飞 AI 大学堂 微调工程师认证"
                class="h-full w-full object-contain p-2"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="text-base font-semibold text-text-primary">微调工程师认证</h3>
              <p class="mt-1 text-sm text-text-muted">科大讯飞 AI 大学堂</p>
              <p class="mt-1 text-xs text-text-muted">有效期至：2028-08-06</p>
            </div>
          </article>

          <article class="overflow-hidden rounded-2xl border border-border bg-bg-secondary transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-accent/5">
            <div class="aspect-[4/3] overflow-hidden bg-white">
              <img
                src={`${import.meta.env.BASE_URL}zhengshu/rag-engineer.png`}
                alt="科大讯飞 AI 大学堂 RAG 工程师认证"
                class="h-full w-full object-contain p-2"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="text-base font-semibold text-text-primary">RAG 工程师认证</h3>
              <p class="mt-1 text-sm text-text-muted">科大讯飞 AI 大学堂</p>
              <p class="mt-1 text-xs text-text-muted">有效期至：2028-08-06</p>
            </div>
          </article>

          <article class="overflow-hidden rounded-2xl border border-border bg-bg-secondary transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-accent/5">
            <div class="aspect-[4/3] overflow-hidden bg-white">
              <img
                src={`${import.meta.env.BASE_URL}zhengshu/prompt-engineer.png`}
                alt="科大讯飞 AI 大学堂 Prompt 工程师认证"
                class="h-full w-full object-contain p-2"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="text-base font-semibold text-text-primary">Prompt 工程师认证</h3>
              <p class="mt-1 text-sm text-text-muted">科大讯飞 AI 大学堂</p>
              <p class="mt-1 text-xs text-text-muted">有效期至：2028-08-07</p>
            </div>
          </article>

          <article class="overflow-hidden rounded-2xl border border-border bg-bg-secondary transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-accent/5">
            <div class="aspect-[4/3] overflow-hidden bg-white">
              <img
                src={`${import.meta.env.BASE_URL}zhengshu/agent-engineer.png`}
                alt="科大讯飞 AI 大学堂 智能体工程师认证"
                class="h-full w-full object-contain p-2"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="text-base font-semibold text-text-primary">智能体工程师认证</h3>
              <p class="mt-1 text-sm text-text-muted">科大讯飞 AI 大学堂</p>
              <p class="mt-1 text-xs text-text-muted">有效期至：2028-08-06</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Global Glow 区：适老化智能产品调研实践 -->
    <section class="relative z-10 py-52 sm:py-64 bg-bg-secondary/50" aria-labelledby="glow-heading">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <SectionTitle
          id="glow-heading"
          title="Global Glow"
          subtitle="适老化智能产品调研实践 · 让科技为长辈发光"
        />

        <!-- 调研概述：点明调研目的与方式 -->
        <p class="mx-auto mt-4 max-w-3xl text-center text-base leading-loose text-text-secondary sm:text-lg">
          为了解适老化智能产品的真实使用痛点，我开展了一次专项调研，通过线上+线下结合的方式收集素材，并整理成网站内容。
        </p>

        <!-- 调研维度卡片网格：线上调研 / 线下观察 / 核心发现 —— 拉大 padding 与卡片间隙 -->
        <div class="mt-14 grid gap-10 md:grid-cols-3">
          {
            glowSurveyItems.map((item) => (
              <div class="rounded-xl border border-border bg-bg-secondary p-8 transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-xl hover:shadow-accent/5">
                <!-- 维度图标：语义化表达调研方式 -->
                <span class="text-3xl" aria-hidden="true">{item.icon}</span>
                <h3 class="mt-4 text-lg font-bold text-text-primary">{item.title}</h3>
                <p class="mt-4 text-base leading-relaxed text-text-secondary">
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>

        <!-- 实践成果横幅：沉淀为文章发布在行业观察板块 -->
        <div class="mt-12 rounded-2xl border border-accent/30 bg-gradient-to-r from-accent/10 to-pink-500/10 p-8">
          <h3 class="text-center text-xl font-bold text-text-primary">实践成果</h3>
          <p class="mx-auto mt-3 max-w-3xl text-center text-base leading-loose text-text-secondary">
            将调研内容整理成以下文章，发布在个人网站的行业观察板块，获得不少读者反馈。
          </p>
          <!-- 文章标题列表：两篇调研文章 -->
          <ul class="mt-6 flex flex-wrap items-center justify-center gap-4">
            {
              glowAchievements.map((article) => (
                <li class="rounded-full border border-accent/40 bg-bg-primary/60 px-5 py-2 text-sm font-semibold text-accent shadow-sm">
                  {article}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- 个人时间线区：左侧中轴 + 圆点标记的成长轨迹 -->
    <section id="timeline" class="relative z-10 py-52 sm:py-64" aria-labelledby="timeline-heading">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <SectionTitle
          id="timeline-heading"
          title="My Timeline"
          subtitle="个人时间线 · 我的成长轨迹"
        />

        <!-- 时间线列表：左侧竖线为时间轴，卡片依次向下排列 -->
        <ol class="relative mt-12 space-y-10 border-l-2 border-border pl-8 sm:pl-10">
          {
            timelineItems.map((item) => (
              <li class="relative">
                <!-- 时间线圆点：中心对齐到左侧竖线 -->
                <span class="timeline-dot" aria-hidden="true"></span>

                <!-- 时间卡片 -->
                <div class="rounded-xl border border-border bg-bg-secondary/60 p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-[0_8px_30px_-12px_rgba(124,58,237,0.35)]">
                  <!-- 日期徽章 -->
                  <p class="inline-block rounded-full bg-accent/10 px-3 py-0.5 text-sm font-bold tracking-wide text-accent">
                    {item.date}
                  </p>
                  <h3 class="mt-3 text-lg font-bold text-text-primary">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-base leading-relaxed text-text-secondary">
                    {item.description}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </section>

  <!-- ==============================================================
       板块二：关于我（#about）
       原 about 页面内容：个人简介、技能栈、联系方式
       ============================================================== -->
  <section id="about" class="relative min-h-screen py-52 sm:py-64">
    <!-- 左下角幽灵装饰 -->
    <GhostElement opacity={0.15} positionClass="bottom-32 left-4 sm:left-8" />

    <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- 英文花体加粗标题 -->
      <SectionTitle
        title="Who I Am"
        subtitle="大一新生 · 技术服务同学 · 持续成长"
        bold
      />

      <!-- 生活与爱好：三条个人兴趣记录，半透明背景框 + 内边距，与星空背景区分 -->
      <div class="mx-auto mt-10 max-w-2xl">
        <h2 class="mb-6 text-center text-2xl font-bold text-[#c5d3eb] sm:text-3xl">
          生活与爱好
        </h2>
        <ul class="space-y-5">
          <li class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.06] p-6 backdrop-blur-sm transition-colors hover:border-accent/40">
            <span class="text-xl leading-none" aria-hidden="true">🥁🥁</span>
            <div>
              <p class="font-semibold text-[#c5d3eb]">阅读偏好</p>
              <p class="mt-1 text-sm text-[#c5d3eb]/80">喜欢看各种类型的小说。</p>
            </div>
          </li>
          <li class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.06] p-6 backdrop-blur-sm transition-colors hover:border-accent/40">
            <span class="text-xl leading-none" aria-hidden="true">🎸🎸</span>
            <div>
              <p class="font-semibold text-[#c5d3eb]">暑期成就</p>
              <p class="mt-1 text-sm text-[#c5d3eb]/80">完成了拼图挑战。</p>
